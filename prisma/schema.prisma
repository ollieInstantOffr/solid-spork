// Cycle Tracker App — Prisma Schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?

  // Personal
  birthDate     DateTime?

  // Cycle preferences
  goal          String  @default("avoid")   // "avoid" | "ttc" | "track"
  wantPregnant  Boolean @default(false)
  cycleLength   Int     @default(28)
  periodLength  Int     @default(5)

  hasOnboarded     Boolean @default(false)
  tutorialSeen     Boolean @default(false)

  // Personalisation
  pronouns         String  @default("she/her")

  // Phase override — user can manually pin a phase for a day
  phaseOverride    String?  // menstrual | follicular | ovulation | luteal
  phaseOverrideAt  DateTime?

  // JSON string: { menstrual: string[], follicular: string[], ovulation: string[], luteal: string[] }
  phasePreferences String @default("{}")

  // Push notifications
  pushSubscription  String?   // JSON serialised PushSubscription
  notificationTime  String    @default("20:00")  // HH:mm local time
  notifyPeriod      Boolean   @default(true)
  notifyOvulation   Boolean   @default(true)
  lastNotifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth relations
  accounts Account[]
  sessions Session[]

  // App relations
  dailyLogs      DailyLog[]
  partnerInvites PartnerInvite[] @relation("InviteOwner")
  partnerAccess  PartnerInvite[] @relation("InvitePartner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DailyLog {
  id     String   @id @default(cuid())
  userId String
  date   DateTime

  // Flow
  flowIntensity String @default("NONE") // NONE | LIGHT | MEDIUM | HEAVY | SPOTTING

  // Symptoms (stored as JSON string array)
  symptoms String @default("[]")

  // Wellbeing
  mood        String? // GREAT | GOOD | NEUTRAL | LOW | AWFUL
  energyLevel Int?    // 1-5

  // Fertility tracking
  bbt          Float?
  cervicalMucus String? // DRY | STICKY | CREAMY | WATERY | EGG_WHITE

  // Activity
  hadSex Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model PartnerInvite {
  id        String   @id @default(cuid())
  ownerId   String
  partnerId String?
  token     String   @unique @default(cuid())
  status     String   @default("PENDING") // PENDING | ACCEPTED | REVOKED
  accessCode     String?   // 6-digit numeric code required on first open
  partnerMessage String?   // Short message left by the partner
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User  @relation("InviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  partner User? @relation("InvitePartner", fields: [partnerId], references: [id])
}
